{
  "name": "paradise-nursery",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Paradise Nursery plant shopping application built with React and Redux Toolkit.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
